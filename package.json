{
  "name": "@spark/landing",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs dist",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "format": "prettier --write \"**/*.{js,mjs,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,md,css,html}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
